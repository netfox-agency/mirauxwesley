RewriteEngine On
RewriteRule ^qui-sommes-nous-trvaux-de-toiture-nonancourt/?$ /#maison [R=301,L]
RewriteRule ^couvertures-charpentes-nonancourt/?$ /renovation-toiture/ [R=301,L]
RewriteRule ^zinguerie-isolation-nonancourt/?$ /zinguerie-gouttieres/ [R=301,L]
RewriteRule ^nettoyage-nonancourt/?$ /demoussage-toiture/ [R=301,L]
RewriteRule ^photos-travaux-de-toiture-nonancourt/?$ /#chantiers [R=301,L]
RewriteRule ^contact-travaux-de-toiture-nonancourt/?$ /#devis [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options nosniff
  Header always set X-Frame-Options SAMEORIGIN
  Header always set Referrer-Policy strict-origin-when-cross-origin
  <FilesMatch "\.(woff2|avif|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
